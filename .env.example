# Used in every deployment: native, Docker, Compose and Dokploy.
# In Docker and Dokploy, set these in the platform's environment. compose.yaml reads all four from .env or the shell.
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
MAX_FILE_BYTES=20971520
INCOMPLETE_UPLOAD_EXPIRE_AFTER_DAYS=7

# Native and dev only. The Docker image fixes these itself (port 3000, /data, /backups),
# so they have no effect in a container, even with --env-file.
PORT=3000
DATA_DIR=./data
BACKUP_DIR=./backups
